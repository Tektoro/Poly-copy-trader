# Optional: Polygon WSS RPC endpoint for the on-chain OrderFilled / merge listener.
# If unset, chainListener is disabled and detection relies on data-api polling only.
# Get a free WSS endpoint from a provider (Alchemy, QuickNode, Ankr, etc.).
POLYGON_WSS_URL=

# Optional: override the HTTP port for the dashboard (default 3000).
PORT=3000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
