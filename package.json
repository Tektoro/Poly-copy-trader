{
  "name": "polymarket-paper-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Paper-trading bot that simulates copying selected Polymarket leaders against the live orderbook to measure edge capture. Places NO real orders and holds NO keys.",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "screen": "tsx src/screening/screenLeaders.ts",
    "metrics": "tsx src/ledger/metrics.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "ethers": "6.17.0",
    "express": "4.22.2",
    "pino": "9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.21",
    "@types/node": "22.10.7",
    "tsx": "4.22.5",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
